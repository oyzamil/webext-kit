{
	"name": "webext-content-ui",
	"version": "0.0.2",
	"description": "Inject elements into shadow DOM — single or batch anchors, with optional shared styles across shadow roots. Combines Plasmo's batch-anchor injection with WXT's clean UI API.",
	"homepage": "https://github.com/oyzamil/webext-kit#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/oyzamil/webext-kit.git"
	},
	"author": "M.Muzammil <qazi.web@gmail.com> (https://muzammil.work/)",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"shadow-dom",
		"content-script",
		"browser-extension",
		"injection",
		"wxt",
		"plasmo"
	],
	"license": "MIT",
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.11",
		"jsdom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=18"
	}
}
