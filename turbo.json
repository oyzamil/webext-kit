{
	"$schema": "node_modules/turbo/schema.json",
	"globalDependencies": ["tsconfig.json", ".env", ".env.local"],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:compile": {
			"cache": false,
			"persistent": true
		},
		"dev:test": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"outputs": ["dist/**", ".output/**"],
			"dependsOn": ["^build"]
		},
		"test": {
			"outputs": ["tests/**"],
			"dependsOn": ["^build"]
		}
	}
}
