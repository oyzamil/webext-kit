{
	"name": "webext-kit",
	"description": "This is a mono repo for packages used in browser extension development.",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"git": "bun run ./scripts/git-helper.ts add-git",
		"build": "turbo run build",
		"build:pkg": "turbo run build --filter",
		"dev": "turbo run dev --parallel",
		"dev:pkg": "turbo run dev --filter",
		"test": "turbo run test",
		"test:pkg": "turbo run test --filter",
		"lint": "biome lint packages",
		"lint:fix": "biome lint packages --fix",
		"format": "biome format packages --write",
		"format:pkg": "turbo run dev --filter",
		"format:check": "biome format packages --check"
	},
	"devDependencies": {
		"turbo": "^2.10.12",
		"@biomejs/biome": "^2.5.12"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*"
		],
		"catalog": {
			"wxt": "^0.21.4",
			"vite": "^8.2.2",
			"jsdom": "^30.0.1",
			"react": "^19.2.8",
			"tsdown": "^0.23.0",
			"vitest": "^5.0.0",
			"react-dom": "^19.2.8",
			"typescript": "^7.0.2",
			"@types/node": "^26.4.1",
			"tailwindcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/chrome": "^0.2.9",
			"@types/react-dom": "^19.2.7",
			"@wxt-dev/browser": "^0.2.9",
			"@tailwindcss/vite": "^4.3.3",
			"@wxt-dev/auto-icons": "^1.1.2",
			"@vitejs/plugin-react": "^6.1.1",
			"@wxt-dev/module-react": "^1.2.2"
		}
	}
}
