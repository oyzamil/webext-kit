{
	"name": "webext-content-ui-demo",
	"version": "0.0.1",
	"description": "Example WXT extension (React + TypeScript + Tailwind v4) using webext-content-ui for content-script UI",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"react": "catalog:",
		"react-dom": "catalog:",
		"webext-content-ui": "workspace:*"
	},
	"devDependencies": {
		"@wxt-dev/auto-icons": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@wxt-dev/module-react": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wxt": "catalog:"
	}
}
