{
	"name": "webext-content-ui-shared-example",
	"description": "Repro: WXT duplicates shared Tailwind CSS across popup + content script entrypoints instead of emitting one shared chunk",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
