{"manifest_version":3,"name":"CSS Dup Demo","description":"Repro extension: popup + 2 content scripts all import the same tailwind.css. Inspect .output to see it duplicated per-entrypoint instead of shared once.","version":"0.0.1","icons":{"16":"icon-16.png","32":"icon-32.png","48":"icon-48.png","128":"icon-128.png"},"permissions":[],"host_permissions":["*://*.aliexpress.com/*","*://*.ebay.com/*"],"action":{"default_title":"CSS Dup Demo Popup","default_popup":"popup.html"},"content_scripts":[{"matches":["*://*.aliexpress.com/*"],"js":["content-scripts/aliexpress.js"]},{"matches":["*://*.example.com/*"],"js":["content-scripts/ebay.js"]},{"matches":["*://*.aliexpress.com/*","*://*.example.com/*"],"js":["content-scripts/shared.js"]}]}